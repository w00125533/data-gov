# Compose project name — pins network/volume names for predictable test wiring.
COMPOSE_PROJECT_NAME=data-gov

# HMS Postgres
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_DB=metastore

# Neo4j
NEO4J_AUTH=neo4j/data-gov-neo4j

# StarRocks (no auth on FE by default — PoC scope)
STARROCKS_USER=root
STARROCKS_PASSWORD=

# Backend → Neo4j connection (defaults match base-compose Neo4j service)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=data-gov-neo4j
NEO4J_DATABASE=neo4j
METADATA_YAML_DIR=metadata-yaml

# DeepSeek (LLM rerank for search, LangGraph nodes in slice 2b)
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Semantic search
SEARCH_CHROMA_DIR=./data/chroma
SEARCH_EMBED_MODEL=BAAI/bge-small-zh-v1.5
SEARCH_RERANK_THRESHOLD=0.15
SEARCH_RRF_K=60
